# Panel interno (/admin) — protegido por contraseña compartida del equipo
ADMIN_PANEL_PASSWORD=cambiame
# Secreto usado para firmar la cookie de sesión del panel. Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# WhatsApp Business Platform (Meta) — Graph API
# Se usan solo como fallback si todavía no hay una conexión cargada en la base de
# datos (tabla web_whatsapp_connections). Una vez migrado, la app lee de la DB.
# WABA ID: Meta Business Suite > Cuentas de WhatsApp Business
# Access token: Meta for Developers > tu app > WhatsApp > System User token
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# Phone number ID del número del negocio (no es el número de teléfono): Meta for
# Developers > tu app > WhatsApp > Configuración de la API. Se usa para enviar
# mensajes desde /admin/bandeja si la conexión de la DB no tiene phone_number_id.
WHATSAPP_PHONE_NUMBER_ID=

# Webhook de WhatsApp (/webhooks/whatsapp) para la bandeja de conversaciones.
# Verify token: cualquier string largo y aleatorio; el mismo se carga en Meta >
# tu app > WhatsApp > Configuración > Webhook > "Token de verificación".
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret: Meta for Developers > tu app > Configuración de la app > Básica >
# "Clave secreta de la app". Se usa para validar la firma X-Hub-Signature-256.
META_APP_SECRET=

# Canales: conectar cuentas desde el panel (Tech Provider). Mientras falte alguna,
# el botón de ese canal aparece deshabilitado con el motivo.
# Id de la app (es público: lo usa el SDK de Facebook en el navegador).
META_APP_ID=
# Facebook Login for Business > Configuraciones: id de la configuración de Embedded Signup
# de WhatsApp (token System-user que no vence; activo: cuentas de WhatsApp).
# (META_WA_CONFIG_ID, el nombre anterior, también sirve.)
META_ES_CONFIG_ID=
# Versión del Embedded Signup (extras.version de FB.login). v5 trae la coexistencia activada.
WHATSAPP_ES_VERSION=v5
# Facebook Login for Business > Configuraciones: id de la configuración para páginas e Instagram.
META_LOGIN_CONFIG_ID=
# Producto Threads de la app (tiene id y secreto propios). Redirect: <APP_URL>/api/admin/canales/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
# URL pública del panel (links de invitación y redirect de Threads).
APP_URL=https://digibotlatam.com

# Base de datos compartida de la VPS (MySQL). Cada proyecto tiene su propia
# database dentro del mismo servidor; digibot-web usa "digibot_data" (la misma
# que ya usan los workflows de n8n del bot), con tablas propias prefijadas "web_".
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3307
DB_DATABASE=digibot_data
DB_USERNAME=root
DB_PASSWORD=

# Clave para cifrar en la base de datos los access tokens de WhatsApp de cada
# cliente (AES-256-GCM). Debe ser hex de 32 bytes (64 caracteres). Generala con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Una vez generada no se cambia: si se pierde, los tokens guardados quedan
# ilegibles y hay que reconectar los WhatsApp de cada cliente.
TOKEN_ENCRYPTION_KEY=

# Mails de avisos (ej: "tu WhatsApp se desconectó"): SMTP de info@digibotlatam.com.
# Sin esto, los avisos quedan solo en el panel. 465 = TLS directo, 587 = STARTTLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@digibotlatam.com
SMTP_PASS="b/kxe8Q9\I(4"
SMTP_FROM=DigiBot <info@digibotlatam.com>
# A quién le llegan los avisos para superadmins (separados por coma). Por defecto, SMTP_USER.
ALERTS_EMAIL=esteban@digibotlatam.com

# Tareas en segundo plano de WhatsApp (cola de historial y chequeo diario de tokens).
# on / off. Por defecto: prendido en producción, apagado en `next dev` (la base es compartida).
WA_BACKGROUND_JOBS=

# Cobro mensual con dLocal Go (SmartFields + Recurring). Guía: docs/cobros-dlocalgo.md
# DLOCALGO_ENV = sandbox | production. Por defecto sandbox, para que un olvido nunca cobre de verdad.
# En sandbox se leen SOLO las variables *_SANDBOX; en production, las que no tienen sufijo.
# Candado: si el entorno no coincide con la URL de la API (api-sbx vs api), el cobro se apaga solo.
# Las claves son del panel de dLocal Go (Integraciones → API). La SmartFields key la da el soporte.
DLOCALGO_ENV=sandbox
DLOCALGO_API_KEY=
DLOCALGO_API_SECRET=
DLOCALGO_SMARTFIELDS_KEY=
DLOCALGO_API_KEY_SANDBOX=
DLOCALGO_API_SECRET_SANDBOX=
DLOCALGO_SMARTFIELDS_KEY_SANDBOX=
# Opcionales: solo si dLocal Go cambia sus URLs (por defecto, las oficiales de cada entorno).
# DLOCALGO_API_URL=https://api.dlocalgo.com
# DLOCALGO_API_URL_SANDBOX=https://api-sbx.dlocalgo.com
# DLOCALGO_SDK_URL=https://checkout.dlocalgo.com/js/dlocalgo-smartfields-bundled.js
# DLOCALGO_SDK_URL_SANDBOX=https://checkout-sbx.dlocalgo.com/js/dlocalgo-smartfields-bundled.js
# Dónde avisa dLocal Go cada pago. Por defecto <BILLING_PUBLIC_URL>/api/billing/dlocalgo/notificaciones.
DLOCALGO_NOTIFICATION_URL=
# URL pública para success_url / back_url / notificaciones. Por defecto APP_URL.
# En local: la del túnel de cloudflared (cambia en cada arranque). En producción: vacía.
BILLING_PUBLIC_URL=
# Hora (Argentina, 0-23) desde la que el job cobra las renovaciones del día. Por defecto 9.
# El job corre dentro de WA_BACKGROUND_JOBS: si está en off, no se cobra nada automático.
BILLING_RUN_HOUR=9

# Deploy / Docker (VPS)
# APP_VERSION la pisa scripts/deploy.sh en cada deploy; no hace falta tocarla a mano.
# Se muestra en el footer ("v0.6.0"). Se toma al buildear: cambiarla requiere rebuild.
APP_VERSION=0.1.0
# Puerto del HOST que mapea al contenedor (el reverse proxy/nginx apunta acá).
# Ojo: no usar el nombre "PORT" a secas, Next.js lo toma como el puerto interno
# del server y pisaría el 3000 del contenedor.
HOST_PORT=8089

# Ayuda: webhook de n8n del bot de soporte de la plataforma (sin esto, solo responden las preguntas frecuentes)
HELP_BOT_WEBHOOK_URL=
# Opcional: se manda en el header X-DigiBot-Secret para que n8n valide que viene del panel
HELP_BOT_WEBHOOK_SECRET=
