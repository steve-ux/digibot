# Panel interno (/admin) — protegido por contraseña compartida del equipo
ADMIN_PANEL_PASSWORD=cambiame
# Secreto usado para firmar la cookie de sesión del panel. Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# WhatsApp Business Platform (Meta) — Graph API
# Se usan solo como fallback si todavía no hay una conexión cargada en la base de
# datos (tabla web_whatsapp_connections). Una vez migrado, la app lee de la DB.
# WABA ID: Meta Business Suite > Cuentas de WhatsApp Business
# Access token: Meta for Developers > tu app > WhatsApp > System User token
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Base de datos compartida de la VPS (MySQL). Cada proyecto tiene su propia
# database dentro del mismo servidor; digibot-web usa "digibot_data" (la misma
# que ya usan los workflows de n8n del bot), con tablas propias prefijadas "web_".
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3307
DB_DATABASE=digibot_data
DB_USERNAME=root
DB_PASSWORD=

# Clave para cifrar en la base de datos los access tokens de WhatsApp de cada
# cliente (AES-256-GCM). Debe ser hex de 32 bytes (64 caracteres). Generala con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Una vez generada no se cambia: si se pierde, los tokens guardados quedan
# ilegibles y hay que reconectar los WhatsApp de cada cliente.
TOKEN_ENCRYPTION_KEY=

# Deploy / Docker (VPS)
# APP_VERSION la pisa scripts/deploy.sh en cada deploy; no hace falta tocarla a mano.
APP_VERSION=0.1.0
# Puerto del HOST que mapea al contenedor (el reverse proxy/nginx apunta acá).
# Ojo: no usar el nombre "PORT" a secas, Next.js lo toma como el puerto interno
# del server y pisaría el 3000 del contenedor.
HOST_PORT=8089
